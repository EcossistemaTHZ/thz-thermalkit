# THZ-LANG — Fechamento de Caixa na Sintaxe Moderna Enxuta
programa NEGOCIO FechamentoCaixaEnxuto:
    regra AuditoriaCaixa:
        operacao calcularSaldoEsperado(trocoInicial: DECIMAL(12, 2), vendasDinheiro: DECIMAL(12, 2), sangrias: DECIMAL(12, 2)) -> DECIMAL(12, 2):
            retorne (trocoInicial + vendasDinheiro) - sangrias

        operacao calcularQuebra(gavetaContada: DECIMAL(12, 2), saldoEsperado: DECIMAL(12, 2)) -> DECIMAL(12, 2):
            retorne gavetaContada - saldoEsperado

    procedimento Principal():
        trocoInicial := 100.00
        vendasDinheiro := 450.00
        sangrias := 200.00
        gavetaContada := 350.00

        saldoEsperado := AuditoriaCaixa.calcularSaldoEsperado(trocoInicial, vendasDinheiro, sangrias)
        diferencaQuebra := AuditoriaCaixa.calcularQuebra(gavetaContada, saldoEsperado)

        exiba "================================================"
        exiba "   FECHAMENTO DE CAIXA ENXUTO (AUDITORIA REAL)  "
        exiba "================================================"
        exiba "Fundo de Troco Inicial : R$ " + trocoInicial
        exiba "Vendas em Dinheiro     : R$ " + vendasDinheiro
        exiba "Sangrias / Retiradas   : R$ " + sangrias
        exiba "------------------------------------------------"
        exiba "Saldo Esperado Gaveta  : R$ " + saldoEsperado
        exiba "Dinheiro Contado       : R$ " + gavetaContada
        exiba "Diferenca de Caixa     : R$ " + diferencaQuebra

        se diferencaQuebra == 0.00:
            exiba "Situacao: EXATO (SEM DIFERENCA)"
        senao:
            se diferencaQuebra > 0.00:
                exiba "Situacao: SOBRA DE CAIXA (+)"
            senao:
                exiba "Situacao: FALTA / QUEBRA DE CAIXA (-)"
        exiba "================================================"
