{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THZ ThermalKit",
  "version": "0.2.0",
  "identifier": "com.ecossistemathz.thermalkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "THZ ThermalKit — Impressão Térmica Direta",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
